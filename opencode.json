{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "permission": {
        "task": { "*": "deny", "coder": "allow", "reviewer": "allow", "tester": "allow" }
      }
    },
    "coder": {
      "mode": "subagent",
      "permission": { "task": "deny", "checkpoint": "deny" }
    },
    "reviewer": {
      "mode": "subagent",
      "permission": { "task": "deny", "edit": "deny", "bash": "deny", "checkpoint": "deny" }
    },
    "tester": {
      "mode": "subagent",
      "permission": { "task": "deny", "edit": "deny", "bash": "ask", "checkpoint": "deny" }
    }
  }
}
