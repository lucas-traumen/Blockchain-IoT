# Host của MQTT broker (Mosquitto) — backend kết nối để nhận telemetry.
MQTT_HOST=localhost

# Port MQTT broker (chuẩn 1883, không TLS trong demo).
MQTT_PORT=1883

# Đường dẫn database SQLite WAL (file .db không commit).
HRC_DB_PATH=data/hrc.db

# ID thiết bị mặc định khi chạy tool/scripts.
DEVICE_ID=esp32_01

# File cấu hình ngưỡng safety (danh sách phiên bản theo valid_from).
SAFETY_CONFIG=configs/safety-square.yaml

# File cấu hình model/inference (window, horizons, ngưỡng stale...).
MODEL_CONFIG=configs/model.yaml

# Thư mục chứa artifact model (không commit).
MODEL_ARTIFACT_DIR=ai_model/artifacts/lstm-real-20261010

# M3: bật/tắt MQTT listener + control transport của backend
# (đặt false khi chạy test / không có broker). Mặc định: true.
HRC_MQTT_ENABLED=true

# M3: timeout (giây) chờ ack thiết bị cho lệnh session_start/session_stop.
# ESP32 có thể trả ACK muộn trong lúc MQTT control subscription/reconnect ổn định.
HRC_ACK_TIMEOUT_S=8.0

# Runtime báo cáo dùng LSTM (environment requirements-ai.txt).
MODEL_TYPE=lstm

# Optional local blockchain reward bridge. The IoT backend never receives a private key.
HRC_REWARD_API_URL=http://127.0.0.1:3000
HRC_REWARD_INGEST_TOKEN=
HRC_REWARD_BENEFICIARY=
HRC_REWARD_AUTO_START=false
HRC_REWARD_AUTO_SETTLE=false
HRC_REWARD_TIMEOUT_S=10.0
