.venv/
__pycache__/
*.pyc
.pytest_cache/
data/*
!data/samples/
# Benchmark/evaluation evidence (reports, metrics, screenshots) is reviewed
# evidence rather than runtime state, so it is source-controlled. Runtime
# process artifacts created inside those directories stay local.
!data/results/
data/results/**/*.pid
release/
# Keep the canonical production artifact available to Docker builds; ignore
# candidate models and generated reports.
ai_model/artifacts/*
!ai_model/artifacts/lstm-v1/
!ai_model/artifacts/lstm-v1/**
# lstm-v2-synthetic is a reviewed candidate kept under version control for
# seed-stability comparison. Model weights are small enough to track.
!ai_model/artifacts/lstm-v2-synthetic/
!ai_model/artifacts/lstm-v2-synthetic/**
exports/
firmware/esp32/sdkconfig
firmware/esp32/sdkconfig.old
firmware/esp32/managed_components/
firmware/esp32/build/

.venv-ai/
core
core.*

compose.env
.runtime/

firmware/esp32/main/network_config.local.h

# JavaScript dependencies and local credentials
node_modules/
.env
.env.*
!.env.example
!**/.env.example
