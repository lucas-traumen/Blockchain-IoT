# === Quy dinh nop bai (muc 5): chi giu README, contracts, ai_model, iot_code, Report PDF ===
/*
!.gitignore
!README.md
!contracts/
!ai_model/
!iot_code/
!Report_*.pdf
!Report*.pdf

# === Artifact ben trong cac thu muc duoc phep (van ignore) ===
.opencode/state/
.venv/
.venv-ai/
__pycache__/
*.pyc
.pytest_cache/
core
core.*

# ESP-IDF build (ca duong cu firmware/ va moi iot_code/)
firmware/esp32/sdkconfig
firmware/esp32/sdkconfig.old
firmware/esp32/managed_components/
firmware/esp32/build/
iot_code/esp32/build/
iot_code/esp32/managed_components/
**/sdkconfig
**/sdkconfig.old
firmware/esp32/main/network_config.local.h
iot_code/esp32/main/network_config.local.h

# AI artifacts: chi giu lstm-v1 va lstm-v2-synthetic (file trong so demo)
ai_model/artifacts/*
!ai_model/artifacts/lstm-v1/
!ai_model/artifacts/lstm-v1/**
!ai_model/artifacts/lstm-v2-synthetic/
!ai_model/artifacts/lstm-v2-synthetic/**

# Secrets/credentials (phong khi co trong folder duoc phep)
node_modules/
.env
.env.*
compose.env
.runtime/
exports/
release/
data/
