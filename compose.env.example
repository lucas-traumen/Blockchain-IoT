# Ports chosen to coexist with other projects already using 1883/1884/8000.
HRC_MQTT_HOST_PORT=1885
HRC_API_HOST_PORT=8001
HRC_MQTT_BIND=0.0.0.0
HRC_API_BIND=0.0.0.0
HRC_DEVICE_ID=esp32_01

# RF runtime (no TensorFlow):
HRC_RUNTIME_TARGET=backend
HRC_MODEL_TYPE=rf
HRC_MODEL_SUBDIR=

# LSTM runtime: set HRC_RUNTIME_TARGET=ai, HRC_MODEL_TYPE=lstm,
# HRC_MODEL_SUBDIR=lstm-v1; put validated artifacts in ai_model/artifacts/lstm-v1.
# AI tools write host datasets/artifacts as this UID/GID (set with id -u / id -g).
HRC_AI_UID=1000
HRC_AI_GID=1000
