# Pullable runtime image. Replace with the tag published by your registry on a
# deployment machine, for example ghcr.io/<org>/blockchain-hrc:ai.
HRC_IMAGE=blockchain-hrc:ai

# Ports chosen to coexist with other projects already using 1883/1884/8000.
HRC_MQTT_HOST_PORT=1885
HRC_API_HOST_PORT=8001
HRC_MQTT_BIND=0.0.0.0
HRC_API_BIND=0.0.0.0
HRC_DASHBOARD_HOST_PORT=8080
HRC_DASHBOARD_BIND=0.0.0.0
HRC_DEVICE_ID=esp32_01
HRC_ACK_TIMEOUT_S=8.0
HRC_SOURCE_MODE=simulator

# LSTM runtime mặc định; benchmark synthetic-only, Sp=40 mm.
HRC_RUNTIME_TARGET=ai
HRC_MODEL_TYPE=lstm
HRC_MODEL_SUBDIR=lstm-v1

# AI tools write host datasets/artifacts as this UID/GID (set with id -u / id -g).
HRC_AI_UID=1000
HRC_AI_GID=1000

# Mô phỏng một cạnh hình vuông: Sp cố định 40 mm cho dữ liệu mới.
HRC_SAFETY_CONFIG=safety-square.yaml

# Optional bridge from the container to the local blockchain_api on the host.
HRC_REWARD_API_URL=http://host.docker.internal:3000
HRC_REWARD_INGEST_TOKEN=
HRC_REWARD_BENEFICIARY=
HRC_REWARD_AUTO_START=false
HRC_REWARD_AUTO_SETTLE=false
HRC_REWARD_TIMEOUT_S=10.0
HRC_CHAIN_API_URL=
HRC_CHAIN_INGEST_TOKEN=
HRC_CHAIN_AUTO_SUBMIT=false
HRC_CHAIN_MAX_ATTEMPTS=8
HRC_VIOLATION_CONFIRMATION=true
HRC_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
