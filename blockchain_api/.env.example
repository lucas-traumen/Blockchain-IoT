RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=YOUR_CONTRACT_ADDRESS
PRIVATE_KEY=YOUR_HARDHAT_PRIVATE_KEY
PORT=3000
# Optional fixed reward contract deployment; otherwise reward-localhost.json is used.
HRC_REWARD_ADDRESS=YOUR_REWARD_CONTRACT_ADDRESS
HRC_REWARD_DEPLOYMENT=../smart_contracts/deployments/reward-localhost.json

# Distinct Bearer tokens for writes; use random values of at least 32 chars.
HRC_INGEST_API_TOKEN=REPLACE_WITH_32_PLUS_CHAR_INGEST_TOKEN
HRC_ADMIN_API_TOKEN=REPLACE_WITH_DIFFERENT_32_PLUS_CHAR_ADMIN_TOKEN
# Dashboard selects this account; if empty it discovers the latest reward beneficiary.
HRC_DASHBOARD_BENEFICIARY=
HRC_REWARD_DEPLOYMENT_BLOCK=0

# Two fixed local Hardhat demo users. Their keys are derived from the local
# Hardhat mnemonic inside the backend; no key is sent to the browser.
HRC_DEMO_MNEMONIC=test test test test test test test test test test test junk
HRC_DEMO_INITIAL_BALANCE=20
HRC_DEMO_SESSION_STORE_PATH=./data/demo-sessions.json
# Account-bound sensor lifecycle: fixed-beneficiary auto-start/settle stays disabled in IoT.
HRC_IOT_API_URL=http://127.0.0.1:8001
HRC_DEMO_DEVICE_ID=esp32_01

# Optional legacy MetaMask/customer identity layer. It is not used by the demo
# account flow above and can remain disabled for this local product demo.
HRC_CUSTOMER_STORE_PATH=./data/customers.json
HRC_APP_CHAIN_ID=31337
HRC_AUTH_CHALLENGE_TTL_S=300
HRC_APP_SESSION_TTL_S=86400
HRC_APP_ADMIN_WALLETS=
HRC_APP_ORIGIN=http://localhost:8080

# Demo accepts only admin/user_1/user_2; arbitrary wallet registration is off.
# The separate legacy EIP-191 application requires explicit mode "wallet".
HRC_APP_AUTH_MODE=demo
