RPC_URL=http://127.0.0.1:8545
HRC_BLOCKCHAIN_NETWORK=localhost
# Local launcher writes deployment files and derives the operator signer from
# HRC_LOCAL_CHAIN_MNEMONIC. Public testnets require an explicit operator key.
HRC_SAFETY_DEPLOYMENT=../smart_contracts/deployments/localhost.json
CONTRACT_ADDRESS=
PRIVATE_KEY=
PORT=3000
# Optional fixed reward contract deployment; otherwise reward-localhost.json is used.
HRC_REWARD_ADDRESS=
HRC_REWARD_DEPLOYMENT=../smart_contracts/deployments/reward-localhost.json

# Gateway ingestion token; use a random value of at least 32 chars.
# Admin access uses SIWE + HRC_APP_ADMIN_WALLETS.
HRC_INGEST_API_TOKEN=
# Dashboard selects this account; if empty it discovers the latest reward beneficiary.
HRC_DASHBOARD_BENEFICIARY=
HRC_REWARD_DEPLOYMENT_BLOCK=0

# Wallet session/evidence store; set legacy paths explicitly when migrating.
HRC_SESSION_STORE_PATH=./data/wallet-sessions.json
# Account-bound sensor lifecycle: fixed-beneficiary auto-start/settle stays disabled in IoT.
HRC_IOT_API_URL=http://127.0.0.1:8002
HRC_DEVICE_ID=esp32_01

# MetaMask/SIWE application identity; one token for application and reward routes.
HRC_CUSTOMER_STORE_PATH=./data/customers.json
HRC_APP_CHAIN_ID=31337
HRC_AUTH_CHALLENGE_TTL_S=300
HRC_APP_SESSION_TTL_S=86400
HRC_APP_ADMIN_WALLETS=
HRC_APP_ORIGIN=http://localhost:8081
HRC_APP_AUTH_MODE=siwe

# sqlite (default) or json (legacy/local only). SQLite uses node:sqlite.
# Migrate an existing JSON snapshot with: node scripts/migrate_json_to_sqlite.js
HRC_APP_STORE=sqlite
# HRC_APP_DB_PATH=/data/customers.db
# HRC_APP_SESSION_DB_PATH=/data/wallet-sessions.db
