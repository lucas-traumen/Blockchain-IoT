{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hrc-safety-log.local/schemas/model_manifest_v1.schema.json",
  "title": "Model manifest v1 (LSTM)",
  "description": "Manifest artifact model LSTM đích TV3–TV4, ghi cạnh file model khi train trong environment AI riêng. Contract input [10,2] (window 10 timestep × [distance_m, delta_distance_m]), output [5] (5 horizon), đơn vị mét.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_type",
    "model_version",
    "preprocessing_version",
    "framework",
    "input_shape",
    "output_shape",
    "features",
    "units",
    "window_size",
    "delta_s",
    "horizons_ms",
    "random_seed",
    "model_file_sha256",
    "dataset_sha256",
    "split_manifest_sha256",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "model_type": {
      "const": "lstm"
    },
    "model_version": {
      "type": "string",
      "pattern": "^lstm-"
    },
    "preprocessing_version": {
      "type": "string",
      "pattern": "^pp-lstm-"
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "tensorflow"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "keras_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_shape": {
      "type": "array",
      "prefixItems": [
        {
          "const": 10
        },
        {
          "const": 2
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "description": "(window_size, số feature mỗi timestep) = (10, 2)."
    },
    "output_shape": {
      "type": "array",
      "prefixItems": [
        {
          "const": 5
        }
      ],
      "minItems": 1,
      "maxItems": 1,
      "description": "Số horizon dự báo = 5."
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Tên feature mỗi timestep theo thứ tự, ví dụ [distance_m, delta_distance_m]."
    },
    "units": {
      "const": "m"
    },
    "window_size": {
      "type": "integer",
      "const": 10
    },
    "delta_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "horizons_ms": {
      "type": "array",
      "items": {
        "type": "integer",
        "enum": [
          100,
          200,
          300,
          400,
          500
        ]
      },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "random_seed": {
      "type": "integer",
      "minimum": 0
    },
    "model_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 của file model (model.keras) để đối soát tính toàn vẹn artifact."
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 của file dataset JSONL dùng để train (PLAN mục 4)."
    },
    "split_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 của split_manifest.json nhúng/kèm artifact (PLAN mục 4)."
    },
    "scaler_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 của scaler.json (artifact bắt buộc của pipeline pp-lstm-v1). Trainer M11 luôn ghi; field là optional trong schema để tương thích backward với fixture M10."
    },
    "n_train_windows": {
      "type": "integer",
      "minimum": 0,
      "description": "Số cửa sổ split train (khớp split_manifest.json)."
    },
    "n_val_windows": {
      "type": "integer",
      "minimum": 0,
      "description": "Số cửa sổ split validation."
    },
    "n_test_windows": {
      "type": "integer",
      "minimum": 0,
      "description": "Số cửa sổ split test."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metrics_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash metrics của checkpoint phát hành; optional cho artifact M11a cũ."
    }
  }
}
