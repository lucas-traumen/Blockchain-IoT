{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hrc-safety-log.local/schemas/event_package_v1.schema.json",
  "title": "TV3/TV4 event package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "processor_version",
    "mode",
    "session_id",
    "trigger_ref",
    "confirmed_ref",
    "trigger_monotonic_us",
    "assessment",
    "pre_ms",
    "post_ms",
    "raw_samples",
    "coverage",
    "package_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "enum": [
        "VIOLATION",
        "UNKNOWN",
        "PREDICTED_WARNING"
      ]
    },
    "confirmation_status": {
      "enum": ["OBSERVED", "CONFIRMED"]
    },
    "confirmation_rule": {
      "enum": ["legacy_transition", "2_of_3_valid_consecutive"]
    },
    "evidence_count": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "chain_eligible": {
      "type": "boolean"
    },
    "processor_version": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "live",
        "offline"
      ]
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "trigger_ref": {
      "$ref": "assessment_v1.schema.json#/properties/sample_ref"
    },
    "confirmed_ref": {
      "$ref": "assessment_v1.schema.json#/properties/sample_ref"
    },
    "trigger_monotonic_us": {
      "type": "integer",
      "minimum": 0
    },
    "assessment": {
      "$ref": "assessment_v1.schema.json"
    },
    "pre_ms": {
      "const": 2000
    },
    "post_ms": {
      "const": 1000
    },
    "raw_samples": {
      "type": "array",
      "items": {
        "$ref": "telemetry_v1.schema.json"
      }
    },
    "package_status": {
      "enum": [
        "collecting",
        "ready"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_complete",
        "post_complete",
        "pre_available_ms",
        "post_available_ms",
        "sequence_gap_count",
        "timing_gap_count",
        "complete"
      ],
      "properties": {
        "pre_complete": {
          "type": "boolean"
        },
        "post_complete": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "pre_available_ms": {
          "type": "number",
          "minimum": 0
        },
        "post_available_ms": {
          "type": "number",
          "minimum": 0
        },
        "sequence_gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "timing_gap_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
