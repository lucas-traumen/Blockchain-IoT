{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hrc-safety-log.local/schemas/control_v1.schema.json",
  "title": "Control command v1",
  "description": "Lệnh điều khiển iot_backend → device, topic hrc/v1/devices/{device_id}/control (QoS1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command", "session_id", "issued_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "command": { "enum": ["session_start", "session_stop"] },
    "session_id": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" }
  }
}
