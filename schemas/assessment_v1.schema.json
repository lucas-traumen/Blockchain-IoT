{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hrc-safety-log.local/schemas/assessment_v1.schema.json",
  "title": "Assessment record v1",
  "description": "Bản ghi bàn giao TV2 lưu trong processed_samples.result_json (spec §8).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_ref",
    "session_id",
    "measured_at",
    "computed_at",
    "received_at",
    "distance_m",
    "safety",
    "prediction"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "sample_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "boot_id", "sequence"],
      "properties": {
        "device_id": { "type": "string", "minLength": 1 },
        "boot_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 }
      }
    },
    "session_id": { "type": ["string", "null"] },
    "measured_at": { "type": ["string", "null"], "format": "date-time" },
    "computed_at": { "type": "string", "format": "date-time" },
    "received_at": { "type": ["string", "null"], "format": "date-time" },
    "distance_m": { "type": ["number", "null"] },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sensor_valid",
        "assessment_valid",
        "sp_m",
        "margin_m",
        "config_version",
        "config_time_source",
        "components",
        "config_fit_warnings"
      ],
      "properties": {
        "status": { "enum": ["CLEAR", "VIOLATION", "UNKNOWN"] },
        "sensor_valid": { "type": "boolean" },
        "assessment_valid": { "type": "boolean" },
        "sp_m": { "type": ["number", "null"] },
        "margin_m": { "type": ["number", "null"] },
        "config_version": { "type": ["string", "null"] },
        "config_time_source": { "enum": ["measured_at", "received_at", null] },
        "components": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["sh_m", "sr_m", "ss_m", "c_m", "zd_m", "zr_m"],
          "properties": {
            "sh_m": { "type": "number" },
            "sr_m": { "type": "number" },
            "ss_m": { "type": "number" },
            "c_m": { "type": "number" },
            "zd_m": { "type": "number" },
            "zr_m": { "type": "number" }
          }
        },
        "config_fit_warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "model_version",
        "horizons_ms",
        "distance_m",
        "early_warning",
        "stale",
        "window_ref",
        "mode"
      ],
      "properties": {
        "status": { "enum": ["OK", "WARMUP", "INVALID_WINDOW", "MODEL_UNAVAILABLE"] },
        "model_version": { "type": ["string", "null"] },
        "horizons_ms": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 5,
          "maxItems": 5
        },
        "distance_m": {
          "type": ["array", "null"],
          "items": { "type": "number" },
          "minItems": 5,
          "maxItems": 5,
          "description": "5 dự báo tương ứng horizons_ms; null khi status != OK."
        },
        "early_warning": { "type": ["boolean", "null"] },
        "stale": { "type": "boolean" },
        "window_ref": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "device_id",
            "boot_id",
            "sequence_first",
            "sequence_last",
            "sample_count",
            "max_age_ms"
          ],
          "properties": {
            "device_id": { "type": "string", "minLength": 1 },
            "boot_id": { "type": "string", "minLength": 1 },
            "sequence_first": { "type": "integer", "minimum": 1 },
            "sequence_last": { "type": "integer", "minimum": 1 },
            "sample_count": { "type": "integer", "minimum": 1 },
            "max_age_ms": { "type": "number", "minimum": 0 }
          }
        },
        "mode": { "enum": ["live", "offline"] },
        "preprocessing_version": {
          "type": ["string", "null"],
          "description": "Phiên bản preprocessing tạo dự báo (vd pp-lstm-v1). Optional cho bản ghi RF cũ; null/khiếm mặt khi status != OK."
        },
        "predicted_violation_ms": {
          "type": ["integer", "null"],
          "enum": [100, 200, 300, 400, 500, null],
          "description": "Horizon sớm nhất (ms) dự báo vi phạm Sp — bắt buộc là một trong các horizon của config; null khi không dự báo được vi phạm hoặc status != OK."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "OK" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "distance_m": { "type": "array" },
              "early_warning": { "type": "boolean" },
              "window_ref": { "type": "object" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["WARMUP", "INVALID_WINDOW", "MODEL_UNAVAILABLE"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "distance_m": { "type": "null" },
              "early_warning": { "type": "null" },
              "window_ref": { "type": "null" },
              "preprocessing_version": { "type": "null" },
              "predicted_violation_ms": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
