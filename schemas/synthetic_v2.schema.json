{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hrc-safety-log.local/schemas/synthetic_v2.schema.json",
  "title": "Synthetic Dataset V2 sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_version", "generator_version", "session_id", "sequence",
    "measured_at", "monotonic_us", "distance_true_m", "distance_measured_m",
    "delta_distance_m", "sensor_valid", "fault_code", "scenario", "seed",
    "split", "simulation_mode", "threshold_m", "target_d100_m", "target_d200_m",
    "target_d300_m", "target_d400_m", "target_d500_m", "crossing_h100",
    "crossing_h200", "crossing_h300", "crossing_h400", "crossing_h500"
  ],
  "properties": {
    "dataset_version": {"const": "synthetic-v2"},
    "generator_version": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "pattern": "^simv2_[A-Za-z0-9_.:-]+$"},
    "sequence": {"type": "integer", "minimum": 1},
    "measured_at": {"type": "string", "format": "date-time"},
    "monotonic_us": {"type": "integer", "minimum": 0},
    "distance_true_m": {"type": "number", "minimum": 0, "maximum": 4.5},
    "distance_measured_m": {"type": ["number", "null"], "minimum": 0, "maximum": 4.5},
    "delta_distance_m": {"type": ["number", "null"]},
    "sensor_valid": {"type": "boolean"},
    "fault_code": {"type": ["string", "null"]},
    "scenario": {"type": "string", "minLength": 1},
    "speed_level": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "split": {"enum": ["train", "val", "test"]},
    "simulation_mode": {"const": true},
    "threshold_m": {"const": 0.04},
    "target_d100_m": {"type": ["number", "null"]},
    "target_d200_m": {"type": ["number", "null"]},
    "target_d300_m": {"type": ["number", "null"]},
    "target_d400_m": {"type": ["number", "null"]},
    "target_d500_m": {"type": ["number", "null"]},
    "crossing_h100": {"type": "boolean"},
    "crossing_h200": {"type": "boolean"},
    "crossing_h300": {"type": "boolean"},
    "crossing_h400": {"type": "boolean"},
    "crossing_h500": {"type": "boolean"},
    "crossing_id": {"type": ["integer", "null"], "minimum": 1}
  }
}
